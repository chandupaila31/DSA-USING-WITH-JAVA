class Solution {
    public boolean isHappy(int n) {
        
        // Base case: if n becomes 1 or 7, it is a happy number
        if(n == 1 || n == 7) return true;
        
        // If n is a single digit (other than 1 or 7), it is not a happy number
        else if(n < 10) return false;
        
        else{
            // Initialize sum to 0
            int sum = 0;
            
            // Process each digit of the number
            while(n > 0){
                
                // Extract the last digit
                int temp = n % 10;
                
                // Add the square of the digit to sum
                sum += temp * temp;
                
                // Remove the last digit from n
                n = n / 10;
            }
            
            // Recursively check if the new sum is a happy number
            return isHappy(sum);
        }
    }
}
