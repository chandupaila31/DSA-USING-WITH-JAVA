class Solution {
    public int addDigits(int num) {
        if(num<10){
            return num;
        }
        if(num==0){
            return 0;
        }
        int res=0;
        while(num!=0){
            int digit=num%10;
            res+=digit;
            num/=10;
        }
        return addDigits(res);
    }
}
