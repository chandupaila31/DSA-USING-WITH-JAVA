class Solution {
    public int mySqrt(int x) {
        // return (int)Math.sqrt(x);
        int low=0;
        int high =100000,ans=0;
        while(low<=high){
            int mid=(low+high)/2;
            if((long)mid*mid<=x){
                ans=mid;
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        return ans;
    }
}
